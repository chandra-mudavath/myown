# ─── Application ──────────────────────────────────────────────
APP_NAME="CovrentTax"
# production refuses to start unless DEBUG=false, SECRET_KEY is random (32+ chars),
# PUBLIC_BASE_URL is https:// and ALLOWED_HOSTS lists the real host names.
# Behind nginx run uvicorn with --proxy-headers --forwarded-allow-ips=127.0.0.1 so sign-in limits see real IPs.
APP_ENV="development"            # development | production
DEBUG=true
SECRET_KEY="CHANGE-ME-USE-openssl-rand-hex-32"
ALLOWED_HOSTS="localhost,127.0.0.1"   # production: "covrenttax.com,www.covrenttax.com"
STAFF_SELF_SIGNUP=false          # true = anyone with a @covrenttax.com mailbox can sign up as staff
MAINTENANCE_MODE=false           # true = everyone except signed-in admins sees "We'll be right back"

# ─── Encryption at rest (bank / FBAR numbers, SSN/TIN, e-file PINs) ─
# Required in production. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LOSING THIS KEY MEANS LOSING THAT DATA: keep a copy in Bitwarden, apart from database backups.
# Rotate: put the new key first, keep the old one after a comma, run "alembic upgrade head", then drop the old one later.
DATA_ENCRYPTION_KEYS=""

# ─── JWT ──────────────────────────────────────────────────────
SESSION_IDLE_MINUTES=300           # 5 hours; signed out after this many idle minutes; working renews it
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM="HS256"

# ─── Database ─────────────────────────────────────────────────
# Local Development (MySQL):
DATABASE_URL="mysql+pymysql://root:<password>@localhost:3306/my_own"

# Production (PostgreSQL):
# DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/myown"

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
# true  = run background tasks inside the web process; no Redis or worker needed (local development).
# false = queue them in Redis for the Celery worker (production). Run:
#         celery -A app.core.celery_app worker -l info   (Windows: add --pool=solo)
#         celery -A app.core.celery_app beat -l info     (daily jobs; run exactly one)
CELERY_TASK_ALWAYS_EAGER=true

# ─── File Storage ─────────────────────────────────────────────
UPLOAD_DIR="uploads"
STORAGE_DIR="storage"
CLIENT_DOCUMENTS_DIR="storage/client_documents"
MAX_UPLOAD_SIZE_MB=30

# ─── Email ────────────────────────────────────────────────────
# console = print emails (with their links) in the server log, send nothing. Use for local development.
# smtp    = really send. Resend: SMTP_HOST="smtp.resend.com", SMTP_PORT=465, SMTP_USER="resend",
#           SMTP_PASSWORD="<Resend API key>". The sending domain must be verified in Resend first.
EMAIL_BACKEND="console"          # console | smtp
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="no-reply@covrenttax.com"
EMAIL_FROM_NAME="CovrentTax"
EMAIL_REPLY_TO="support@covrenttax.com"

# ─── Payments (manual: UPI / bank transfer) ───────────────────
# Pay in INR without a gateway (used until Razorpay is set up): the app draws a UPI QR with the amount filled in,
# and shows the India account for bank transfers. The client sends the UPI / UTR reference and an admin verifies it.
PAYMENT_UPI_ID=""                # the CovrentTax India business UPI ID, e.g. "covrenttax@icici"
PAYMENT_UPI_PAYEE="CovrentTax"
PAYMENT_BANK_DETAILS_IN="Account name: CovrentTax …
Account number: …
IFSC: …
Bank: …"
# US wire / ACH details (one item per line)
PAYMENT_BANK_DETAILS="Bank: …
Account name: …
Account number: …
Routing (ACH): …
SWIFT: …"
PAYMENT_PROOFS_DIR="private_storage/payment_proofs"

# ─── Stripe Checkout (Pay in USD: card, Apple Pay, Google Pay, ACH) ───
# dashboard.stripe.com > Developers > API keys. Use test keys (sk_test_ / rk_test_) until go-live.
# Webhook: Developers > Webhooks > Add endpoint  {PUBLIC_BASE_URL}/webhooks/stripe  with the events
#   checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#   checkout.session.expired, charge.refunded, charge.dispute.created, charge.dispute.closed
# Locally: stripe listen --forward-to localhost:8000/webhooks/stripe  (it prints the whsec_ secret)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STATEMENT_DESCRIPTOR=""   # optional, up to 22 characters, e.g. "TAX FEE"
# ─── Razorpay (Pay in INR: UPI / QR, cards, net banking, wallets, bank transfer) ───
# dashboard.razorpay.com > Account & Settings > API Keys. Use Test Mode keys (rzp_test_) until KYC is approved.
# Webhook: Account & Settings > Webhooks > Add  {PUBLIC_BASE_URL}/webhooks/razorpay  with a secret you choose, events
#   payment.captured, payment.failed, order.paid, refund.processed, payment.dispute.created, payment.dispute.won,
#   payment.dispute.lost, virtual_account.credited
# Also in the Dashboard: Payment Methods (UPI, cards, net banking, wallets), auto-capture on, international cards (optional).
# Then set the USD -> INR rate in the app: Admin > Settings > Payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_SMART_COLLECT=false     # true once Razorpay has activated Smart Collect (bank transfer to a per-client account)
PUBLIC_BASE_URL="http://localhost:8000"
