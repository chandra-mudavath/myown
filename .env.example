# ─── Application ──────────────────────────────────────────────
APP_NAME="CovrentTax"
APP_ENV="development"            # development | production
DEBUG=true
SECRET_KEY="CHANGE-ME-USE-openssl-rand-hex-32"
ALLOWED_HOSTS="localhost,127.0.0.1"

# ─── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM="HS256"

# ─── Database ─────────────────────────────────────────────────
# Local Development (MySQL):
DATABASE_URL="mysql+pymysql://root:Chandu@123@localhost:3306/my_own"

# Production (PostgreSQL):
# DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/myown"

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"

# ─── File Storage ─────────────────────────────────────────────
UPLOAD_DIR="uploads"
STORAGE_DIR="storage"
CLIENT_DOCUMENTS_DIR="storage/client_documents"
MAX_UPLOAD_SIZE_MB=10

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="no-reply@covrenttax.com"

# ─── Payments (manual: UPI / bank transfer) ───────────────────
PAYMENT_UPI_ID=""
PAYMENT_UPI_PAYEE="CovrentTax"
PAYMENT_BANK_DETAILS="Bank: …
Account name: …
Account number: …
Routing (ACH): …
SWIFT: …"
PAYMENT_PROOFS_DIR="private_storage/payment_proofs"

# ─── PayPal Checkout (main online payment option) ─────────────
# developer.paypal.com > Apps & Credentials. Use sandbox keys until go-live.
PAYPAL_MODE="sandbox"            # sandbox | live
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Add a webhook pointing at <PUBLIC_BASE_URL>/webhooks/paypal with events
# CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.* and paste its ID here.
PAYPAL_WEBHOOK_ID=""
PUBLIC_BASE_URL="http://localhost:8000"
